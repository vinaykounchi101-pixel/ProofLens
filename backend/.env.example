# ==============================================================================
# ProofLens AI — Backend Environment Configuration Example
# Copy this file to .env and configure your local or deployment environment.
# ==============================================================================

# Application & Environment
# Options: development, production, test
ENVIRONMENT=development
PROJECT_NAME="ProofLens AI"
API_V1_STR=/api/v1

# In production mode, SECRET_KEY must be a cryptographically secure string (e.g. openssl rand -hex 32)
# If left as default in production, startup will fail closed.
SECRET_KEY=prooflens-insecure-dev-secret-key-change-in-prod

# Database Connection
# SQLite for local testing: sqlite+aiosqlite:///./data/prooflens.db
# Local PostgreSQL with pgvector: postgresql+asyncpg://postgres:postgres@localhost:5432/prooflens
# Supabase Transaction Pooler (Port 6543): postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Supabase Session Pooler (Port 5432): postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./data/prooflens.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Local Storage Directory for PDFs
STORAGE_DIR=data/storage
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_PAGES_PER_DOCUMENT=50

# Google Gemini AI Provider Configuration
# Set GEMINI_API_KEY to activate both embedding and LLM generation via Gemini.
# If left blank, ProofLens defaults to deterministic Mock adapters (zero-cost, offline).
GEMINI_API_KEY=

# Provider selection: "gemini" or "mock"
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock

# Model configuration
EMBEDDING_MODEL=models/gemini-embedding-2
LLM_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16

# Grounding & Retrieval Thresholds
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# Free-Tier & Rate Limit Guardrails (FR-14)
RATE_LIMIT_PER_MINUTE=15
MAX_DAILY_QUERIES=200

# Development Mode Identity Key
DEFAULT_DEV_USER_ID=dev-user-00000000-0000-0000-0000-000000000001
DEFAULT_DEV_USER_EMAIL=dev@prooflens.local
DEFAULT_DEV_API_KEY=prooflens_dev_api_key_test_12345
